# ==============================================================================
# CAREQ HEALTHCARE PLATFORM — SECURE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRANSACTIONAL EMAIL OTP SERVICE (LOGIN & SIGNUP VERIFICATION)
# ------------------------------------------------------------------------------
# Provider Options: 'resend', 'sendgrid', 'dev'
EMAIL_PROVIDER=dev
EMAIL_FROM=noreply@careq-health.gov.in

# If using Resend (https://resend.com):
# RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# If using SendGrid:
# SENDGRID_API_KEY=SG.abcdefghijklmnopqrstuvwxyz

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL MOBILE SMS OTP SERVICE (WORKSPACE SWITCHING VERIFICATION)
# ------------------------------------------------------------------------------
# Provider Options: 'twilio', 'msg91', 'dev'
SMS_PROVIDER=dev
SMS_SENDER_ID=CAREQ

# If using Twilio (https://www.twilio.com):
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_FROM_NUMBER=+1234567890

# If using MSG91 (India DLT Compliant):
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME
# ------------------------------------------------------------------------------
PORT=5180
NODE_ENV=development
